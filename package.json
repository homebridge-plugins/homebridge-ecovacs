{
  "name": "@homebridge-plugins/homebridge-ecovacs",
  "displayName": "Homebridge Ecovacs",
  "alias": "Deebot",
  "type": "module",
  "version": "8.3.0",
  "description": "Homebridge plugin to integrate Ecovacs Deebot/Yeedi devices into HomeKit.",
  "author": {
    "name": "bwp91",
    "email": "bwp91@icloud.com"
  },
  "license": "MIT",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/bwp91"
    },
    {
      "type": "kofi",
      "url": "https://ko-fi.com/bwp91"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/bwp91"
    },
    {
      "type": "paypal",
      "url": "https://www.paypal.me/BenPotter"
    }
  ],
  "homepage": "https://github.com/homebridge-plugins/homebridge-ecovacs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homebridge-plugins/homebridge-ecovacs.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge-plugins/homebridge-ecovacs/issues"
  },
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "supports-matter",
    "supports-hap",
    "homebridge-deebot",
    "homebridge-ecovacs",
    "hoobs",
    "hoobs-plugin",
    "homekit",
    "siri",
    "ecovacs",
    "deebot",
    "yeedi",
    "vacuum",
    "hoover"
  ],
  "main": "dist/index.js",
  "engines": {
    "homebridge": "^2.0.0",
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc && npm run plugin-ui",
    "start": "homebridge -U ./test/hbConfig -D",
    "plugin-ui": "cp -r ./src/homebridge-ui ./dist/",
    "watch": "npm run build && npm link && nodemon",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test-coverage": "npm run test -- --coverage",
    "changelog:sync": "node .github/scripts/sync-changelog.mjs"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.3.0",
    "ecovacs-deebot": "^0.9.5",
    "ecovacs-deebot-alpha": "npm:ecovacs-deebot@1.0.0-alpha.23",
    "node-persist": "^4.0.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "homebridge": "^2.5.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "ecovacs-deebot": {
      "@xmldom/xmldom": "^0.9.12",
      "axios": "^1.21.1",
      "canvas": {
        ".": "^2.11.2",
        "@mapbox/node-pre-gyp": {
          "tar": "^7.5.23"
        }
      },
      "simple-xmpp": {
        "node-xmpp-client": {
          ".": "^3.2.0",
          "request": {
            "form-data": "^2.5.6",
            "qs": "^6.17.1"
          },
          "ws": "^8.23.0"
        }
      }
    },
    "ecovacs-deebot-alpha": {
      "axios": "^1.21.1"
    },
    "reconnect-core": "0.0.1"
  },
  "allowScripts": {
    "canvas": true,
    "fsevents": true
  }
}
